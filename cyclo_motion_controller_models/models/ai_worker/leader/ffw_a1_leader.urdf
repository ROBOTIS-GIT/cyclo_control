<?xml version="1.0"?>
<!--
  Kinematics-only A1 leader reference model for cyclo_teleoperation.
  Generated from ffw_a1_leader.urdf.xacro and intentionally excludes
  hardware interfaces, transmissions, visuals, collisions, and inertials.
-->
<robot name="ffw_a1_leader">
  <link name="world" />
  <joint name="joint" type="fixed">
    <parent link="world" />
    <child link="arm_base_link" />
    <origin rpy="0 0 0" xyz="0 0 0" />
  </joint>
  <link name="arm_base_link" />
  <!-- Joint frames share the same orientation at zero DHI positions.
       Use joint4 = -pi/2 for the CAD elbow pose on both arms after DHI conversion.
       Rotate downstream CAD translations and axes +pi/2 about Y to express
       them in the zero-pose frames, keeping all arm joint rpy zero.
       DHI positions remain unchanged; only MoveJ swaps joint1/2. -->
  <joint name="arm_l_joint1" type="revolute">
    <parent link="arm_base_link" />
    <child link="arm_l_link1" />
    <origin rpy="0 0 0" xyz="0 0.1912 0" />
    <axis xyz="1 0 0" />
    <limit effort="1000" lower="-6.28" upper="6.28" velocity="4.8" />
    <dynamics damping="0.1" />
  </joint>
  <link name="arm_l_link1" />
  <joint name="arm_l_joint2" type="revolute">
    <parent link="arm_l_link1" />
    <child link="arm_l_link2" />
