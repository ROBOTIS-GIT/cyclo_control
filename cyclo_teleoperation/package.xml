<?xml version="1.0"?>
<package format="3">
  <name>cyclo_teleoperation</name>
  <version>0.1.0</version>
  <description>Runtime-selectable teleoperation controllers for Cyclo follower robots.</description>
  <maintainer email="kyu@robotis.com">Yeonguk Kim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>cyclo_motion_controller_core</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>robotis_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
